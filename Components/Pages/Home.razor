@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using BookTracker.Models
@inject UserManager<ApplicationUser> UserManager

@* Page used to handle what the user will see in the Home if he is 
authenticated or not *@


<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized Context="auth">
        
        <h1>
            Hello, @fullName!
        </h1>
        <p>
            Please go to your Library to start adding books.
        </p>

        <NavLink class="btn btn-primary" href="/library">
            <i class="bi bi-book-half me-2"></i>
            Go to Library
        </NavLink>

    </Authorized>

    <NotAuthorized>
        <h1>
            Hello, world!
        </h1>
        <p>
            Welcome to your BookTracker.
        </p>
         <p>
            Please, create an account to start tracking your books.
        </p>

         <NavLink class="btn btn-primary" href="/register">
            <i class="bi bi-person-plus-fill me-2"></i>
            Go to Register
        </NavLink>
    </NotAuthorized>
</AuthorizeView>


@code {
    private string fullName ="";
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            fullName = user.FullName;
        }
    }
}