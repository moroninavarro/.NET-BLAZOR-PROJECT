@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized Context="auth">
        
        <h1>
            Hello, @auth.User.Identity?.Name!
        </h1>
        <p>
            Please go to your Library to start adding books.
        </p>

        <NavLink class="btn btn-primary" href="/library">
            <i class="bi bi-book-half me-2"></i>
            Go to Library
        </NavLink>

    </Authorized>

    <NotAuthorized>
        <h1>
            Hello, world!
        </h1>
        <p>
            Welcome to your BookTracker.
        </p>
         <p>
            Please, create an account to start tracking your books.
        </p>

         <NavLink class="btn btn-primary" href="/register">
            <i class="bi bi-person-plus-fill me-2"></i>
            Go to Register
        </NavLink>
    </NotAuthorized>
</AuthorizeView>
