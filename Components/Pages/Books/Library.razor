@page "/library"
@rendermode InteractiveServer
@inject BookService BookService
@using BookTracker.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@using System.Security.Claims
@using BookTracker.Models

<h3 class="mb-4 fw-bold fs-4">My Library</h3>


<button class="btn btn-primary mb-4" @onclick="GoToAddBook"> + Add Book </button>



<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">



@foreach(var book in books)
{
    <div class="col">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold">@book.Title</h5>
                <p class="text-muted mb-2">Author: @book.Author</p>
                <p class="mb-2"><strong>Genre: </strong>@(string.IsNullOrEmpty(book.Genre) ? "Not specified" : book.Genre)</p>
                 <p class="mb-2">Total Pages: @book.TotalPages</p>

                <p class="mb-2">
                    <strong>Status: </strong>
                    @if(book.Status == "Finished")
                    {
                        <span class="badge bg-success">Finished</span>

                    }
                    else if(book.Status == "Reading")
                    {
                        <span class="badge bg-warning text-dark">Reading</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Not Started</span>
                    }

                </p>

                 @if(book.Rating > 0)
                    {
                        <p class="mb-2">
                            Rating:
                        @for(int i =0; i < book.Rating; i++)
                            {
                                <span>⭐</span>
                            }
                        </p>
                    }

                <hr />

                <p class="mb-2">
                    <strong>Progress</strong>

                </p>

                <div class="progress mb-2">

                    <div class="progress-bar"
                    role="progressbar"
                    style="width:@GetProgress(book)%">
                    
                    </div>
                </div>

            <p class="small text-muted mb-2">
                @book.CurrentPage / @book.TotalPages pages
                (@GetProgress(book)%)
            </p>

            <input type="range"
                class="form-range" 
                min="0"
                max="@book.TotalPages"
                value="@book.CurrentPage"
                @oninput="(e) => PreviewProgress(book, e)"
                @onchange="(e) => UpdateProgress(book)" />

           
            <div class="mt-3">
                <strong>Notes:</strong>

                <textarea class="form-control mt-2"
                    rows="4"
                    wrap="soft"
                    placeholder="Write a note..."
                    style="resize: none; overflow-y: auto; overflow-wrap: anywhere;"
                    @bind="book.Notes"
                    @bind:event="oninput"
                    @onblur="() => SaveNotes(book)">
                </textarea>

            </div>

           
        <div class="card-footer bg-transparent border-0">
            <button class="btn btn-outline-primary btn-sm me-2"
                @onclick="() => EditBook(book.BookId)">
                Edit
            </button>

            <button class="btn btn-outline-danger btn-sm"
                @onclick="() => DeleteBook(book.BookId)">
                Delete
            </button>
             </div>
        </div>
        </div>
    </div>
}

</div>

               
          

@code{
    private List<Book> books = new();
    protected override async Task OnInitializedAsync()
    {

        var authState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        var user = authState.User;



        foreach (var claim in user.Claims)
        {
            Console.WriteLine($"{claim.Type} = {claim.Value}");
        }
        if(user.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var userId = user.FindFirst(
            ClaimTypes.NameIdentifier
            )?.Value;

        if(userId != null)
        {
            books = await BookService.GetBooksAsync(userId);
        }
    }

    private int GetProgress(Book book)
    {
        if(book.TotalPages == 0)
        {
            return 0;
        }

        return (int)Math.Round(
            ((double)book.CurrentPage / book.TotalPages) * 100
        );
    }

    private async Task UpdateProgress(Book book)
    {
        await BookService.UpdateBookAsync(book);
    }


    private void PreviewProgress(Book book, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int Page))
        {
            book.CurrentPage = Page;

            if (book.CurrentPage == 0)
                book.Status = "Not Started";
            else if (book.CurrentPage >= book.TotalPages)
                book.Status = "Finished";
            else
                book.Status = "Reading";
        }
    }

    private async Task SaveNotes(Book book)
    {
        await BookService.UpdateBookAsync(book);
    }


    private void EditBook(int bookId)
    {
        Navigation.NavigateTo($"/books/edit/{bookId}");
    }


    private void GoToAddBook()
    {
        Navigation.NavigateTo("/books/add");
    }

    private async Task DeleteBook(int bookId)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

       var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if(userId == null)
        {
            return;
        }

    
        await BookService.DeleteBookAsync(bookId, userId);
        books = await BookService.GetBooksAsync(userId);
    }
}