@page "/books/add"
@rendermode InteractiveServer
@using BookTracker.Models
@inject BookService BookService
@inject NavigationManager Navigation


<h3>Add Book</h3>


<EditForm Model="newBook" OnValidSubmit="SaveBook">
    <DataAnnotationsValidator />
    <ValidationSummary />

<div class="mb-3">
    <label>Title</label>

    <InputText 
        @bind-Value="newBook.Title"
        class="form-control"/>
</div>
    
<div class="mb-3">
    <label>Author</label>
    <InputText
        @bind-Value="newBook.Author"
        class="form-control"/>
</div>

<div class="mb-3">
    <label>Total pages</label>
    <InputNumber
        @bind-Value="newBook.TotalPages"
        class="form-control"/>
</div>

    <button class="btn btn-success">
        Save
    </button>

</EditForm>

@code{
    private Book newBook = new();
    private async Task SaveBook()
    {
        await BookService.AddBookAsync(newBook);

        Navigation.NavigateTo("/library");
    }
}

