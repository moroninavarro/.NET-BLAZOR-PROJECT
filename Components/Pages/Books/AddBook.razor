@page "/books/add"
@using Microsoft.AspNetCore.Identity
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using BookTracker.Models
@using System.Security.Claims
@rendermode InteractiveServer
@inject BookService BookService
@using BookTracker.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Authorization

<h3>Add Book</h3>


<EditForm Model="newBook" OnValidSubmit="SaveBook" FormName="AddBookForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

<div class="mb-3">
    <label>Title</label>

    <InputText 
        @bind-Value="newBook.Title"
        class="form-control"/>
</div>
    
<div class="mb-3">
    <label>Author</label>
    <InputText
        @bind-Value="newBook.Author"
        class="form-control"/>
</div>

<div class="mb-3">
    <label>Total pages</label>
    <InputNumber
        @bind-Value="newBook.TotalPages"
        class="form-control"/>
</div>

    <button class="btn btn-success">
        Save
    </button>

</EditForm>

@code{
    private Book newBook = new();
    private async Task SaveBook()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if(user.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login");
            return;
        
        }

        var userId = user.FindFirst(
           ClaimTypes.NameIdentifier
            )?.Value;

        if(userId == null)
        {
             Navigation.NavigateTo("/login");
                return;
        }

        newBook.UserId = userId;

        await BookService.AddBookAsync(newBook);
        Navigation.NavigateTo("/library");
    }
}

