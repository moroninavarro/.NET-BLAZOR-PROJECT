@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <i class="bi bi-book-half me-2"></i>BookTracker</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill" 
                style="font-size: 1.5rem; width: 1.8rem; margin-right: 0.5rem; position: static; transform: translateY(-12px);" aria-hidden="true"></i> 
                <span>Home</span>
            </NavLink>
        </div>
        

        <AuthorizeView>

            <Authorized>

                <div class="nav-item px-3">
                        <NavLink class="nav-link d-flex align-items-center" href="/library" Match="NavLinkMatch.All">
                            <i class="bi bi-book-fill" style="font-size: 1.5rem; width: 1.8rem; margin-right: 0.5rem; position: static; transform: translateY(-12px);" aria-hidden="true"></i> 
                            <span>Library</span>
                        </NavLink>
                </div>

               <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="/logout">
                    <i class="bi bi-box-arrow-right" style="font-size: 1.5rem; width: 1.8rem; margin-right: 0.5rem; position: static; transform: translateY(-12px);" aria-hidden="true"></i>
                        <span>Logout</span>
                    </NavLink>
                </div>

            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="/login">
                    <i class="bi bi-box-arrow-in-right" style="font-size: 1.5rem; width: 1.8rem; margin-right: 0.5rem; position: static; transform: translateY(-12px);" aria-hidden="true"></i>
                        <span>Login</span>
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/register">
                    <i class="bi bi-person-plus-fill" style="font-size: 1.5rem; width: 1.8rem; margin-right: 0.5rem; position: static; transform: translateY(-12px);" aria-hidden="true"></i>
                        <span>Register</span>
                    </NavLink>
                </div>

            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

