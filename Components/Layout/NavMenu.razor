@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <i class="bi bi-book-half me-2"></i>BookTracker</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        
        <div class="nav-item px-3">
            <NavLink class="nav-link flex align-items-center" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill me-2" aria-hidden="true"></i> Home
            </NavLink>
        </div>
        

        <AuthorizeView>

            <Authorized>

                <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/library" Match="NavLinkMatch.All">
                            <i class="bi bi-book-fill me-2" aria-hidden="true"></i> Library
                        </NavLink>
                </div>

               <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/logout">
                    <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>
                        Logout
                    </NavLink>
                </div>

            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login">
                        Login
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/register">
                        Register
                    </NavLink>
                </div>

            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

